# Auto detect text files and perform LF normalization
* text=auto

# İkili dosyalar — satır sonu dönüşümü uygulanmasın
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary

# Metin dosyaları LF ile
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.xml  text eol=lf
*.json text eol=lf
*.svg  text eol=lf
